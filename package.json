{
  "private": true,
  "scripts": {
    "format": "prettier --write \"**/*.{js,jsx,css,html,json,sql,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,css,html,json,sql,md}\"",
    "test:all": "npm run test:frontend && npm run test:backend",
    "test:frontend": "npm --prefix frontend run build",
    "test:backend": "npm --prefix Backend run test:conflict"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-sql": "^0.20.0"
  }
}
